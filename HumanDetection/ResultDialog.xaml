<UserControl x:Class="HumanDetection.ResultDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HumanDetection" xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Border CornerRadius="3" Background="#0D1117" BorderThickness="1" BorderBrush="#30363D">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- Tabbed Content -->
            <Grid Grid.Row="0" Margin="3">
                <TabControl BorderThickness="0" Background="Transparent"
                            materialDesign:ColorZoneAssist.Mode="Standard">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#161B22"/>
                            <Setter Property="Foreground" Value="#8B949E"/>
                            <Setter Property="BorderBrush" Value="#30363D"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="20,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Background="#161B22" BorderBrush="#30363D" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,-1,0">
                                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="20,8"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#0D1117"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#58A6FF"/>
                                                <Setter Property="Foreground" Value="#58A6FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1C2128"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Details">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0D1117">
                            <ItemsControl ItemsSource="{Binding ResultDataList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" BorderThickness="1" Background="#161B22" BorderBrush="#30363D" Margin="10">
                                            <StackPanel Orientation="Vertical">

                                                <!-- Time Row -->
                                                <StackPanel Orientation="Horizontal" Margin="12,10,12,0">
                                                    <materialIcons:MaterialIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#8B949E"/>
                                                    <TextBlock Margin="8,0,0,0" FontSize="14" Foreground="#8B949E"
                                                               Text="{Binding StartTime, StringFormat='{}{0:hh:mm:ss tt}'}"/>
                                                    <TextBlock Margin="6,0,6,0" FontSize="14" Foreground="#484F58" Text="→"/>
                                                    <TextBlock FontSize="14" Foreground="#8B949E"
                                                               Text="{Binding EndTime, StringFormat='{}{0:hh:mm:ss tt}'}"/>
                                                </StackPanel>

                                                <!-- Metric Cards Row 1: Human, Boxes, Dup Barcode, Expiry -->
                                                <Grid Margin="6,8,6,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:Card Grid.Column="0" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <DockPanel>
                                                            <materialIcons:MaterialIcon Kind="Human" Width="28" Height="28" Foreground="#FF6A00" DockPanel.Dock="Left"/>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Foreground="#8B949E" FontSize="11" Text="Human Detection"/>
                                                                <TextBlock Text="{Binding HumanDetect}" FontSize="16" FontWeight="Bold" Foreground="#FF6A00"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="1" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <DockPanel>
                                                            <materialIcons:MaterialIcon Kind="CubeOutline" Width="28" Height="28" Foreground="#58A6FF" DockPanel.Dock="Left"/>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Foreground="#8B949E" FontSize="11" Text="Total Boxes"/>
                                                                <TextBlock Text="{Binding TotalBoxes}" FontSize="16" FontWeight="Bold" Foreground="#58A6FF"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="2" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <DockPanel>
                                                            <materialIcons:MaterialIcon Kind="BarcodeScan" Width="28" Height="28" Foreground="#D2A8FF" DockPanel.Dock="Left"/>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Foreground="#8B949E" FontSize="11" Text="Duplicate Barcode"/>
                                                                <TextBlock Text="{Binding DublicateBarcode}" FontSize="16" FontWeight="Bold" Foreground="#D2A8FF"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="3" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <DockPanel>
                                                            <materialIcons:MaterialIcon Kind="CalendarClock" Width="28" Height="28" Foreground="#3FB950" DockPanel.Dock="Left"/>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Foreground="#8B949E" FontSize="11" Text="Expiry Date"/>
                                                                <TextBlock Text="{Binding ExpiryDate}" FontSize="16" FontWeight="Bold" Foreground="#3FB950"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </materialDesign:Card>
                                                </Grid>

                                                <!-- Metric Cards Row 2: Pallet Height, Weight, Label Count, Barcode Count -->
                                                <Grid Margin="6,4,6,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:Card Grid.Column="0" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <DockPanel>
                                                            <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="28" Height="28" Foreground="#D29922" DockPanel.Dock="Left"/>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Foreground="#8B949E" FontSize="11" Text="Pallet Height"/>
                                                                <TextBlock Text="{Binding PalletHeight, StringFormat={}{0:F2} m}" FontSize="16" FontWeight="Bold" Foreground="#D29922"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="1" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <DockPanel>
                                                            <materialIcons:MaterialIcon Kind="Weight" Width="28" Height="28" Foreground="#F85149" DockPanel.Dock="Left"/>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Foreground="#8B949E" FontSize="11" Text="Total Weight"/>
                                                                <TextBlock Text="{Binding TotalWeight}" FontSize="16" FontWeight="Bold" Foreground="#F85149"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="2" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <DockPanel>
                                                            <materialIcons:MaterialIcon Kind="Label" Width="28" Height="28" Foreground="#79C0FF" DockPanel.Dock="Left"/>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Foreground="#8B949E" FontSize="11" Text="Label Count"/>
                                                                <TextBlock Text="{Binding LableCount}" FontSize="16" FontWeight="Bold" Foreground="#79C0FF"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="3" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <DockPanel>
                                                            <materialIcons:MaterialIcon Kind="Barcode" Width="28" Height="28" Foreground="#56D364" DockPanel.Dock="Left"/>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Foreground="#8B949E" FontSize="11" Text="Barcode Count"/>
                                                                <TextBlock Text="{Binding BarcodeCodeCount}" FontSize="16" FontWeight="Bold" Foreground="#56D364"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </materialDesign:Card>
                                                </Grid>

                                                <!-- Big Number Cards Row: Distinct Dates, Duplicate Count, Score -->
                                                <Grid Margin="6,4,6,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:Card Grid.Column="0" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialIcons:MaterialIcon Kind="CalendarClock" Width="20" Height="20" Foreground="#3FB950"/>
                                                                <TextBlock Margin="8,0,0,0" Foreground="#8B949E" FontSize="11" Text="Distinct Dates"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DateCount}" FontSize="28" FontWeight="Bold" Foreground="#3FB950" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="1" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialIcons:MaterialIcon Kind="BarcodeScan" Width="20" Height="20" Foreground="#D2A8FF"/>
                                                                <TextBlock Margin="8,0,0,0" Foreground="#8B949E" FontSize="11" Text="Dup. Barcodes"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DublicateBarcodeCount}" FontSize="28" FontWeight="Bold" Foreground="#D2A8FF" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="2" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialIcons:MaterialIcon Kind="Label" Width="20" Height="20" Foreground="#79C0FF"/>
                                                                <TextBlock Margin="8,0,0,0" Foreground="#8B949E" FontSize="11" Text="Label Count"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding LableCount}" FontSize="28" FontWeight="Bold" Foreground="#79C0FF" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="3" Margin="4" Padding="12"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialIcons:MaterialIcon Kind="Star" Width="20" Height="20" Foreground="#D29922"/>
                                                                <TextBlock Margin="8,0,0,0" Foreground="#8B949E" FontSize="11" Text="Score"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Score}" FontSize="28" FontWeight="Bold" Foreground="#D29922" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </materialDesign:Card>
                                                </Grid>

                                                <!-- Date & Barcode Chips -->
                                                <Grid Margin="6,8,6,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:Card Grid.Column="0" Margin="4" Padding="10"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialIcons:MaterialIcon Kind="CalendarClock" Width="18" Height="18" Foreground="#3FB950"/>
                                                                <TextBlock Margin="6,0,0,0" Foreground="#3FB950" FontSize="13" FontWeight="SemiBold" Text="All Dates"/>
                                                            </StackPanel>
                                                            <ScrollViewer Margin="0,6,0,0" MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding DateList}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="3" Padding="8,4" CornerRadius="10"
                                                                                    Background="#1A3FB950" BorderBrush="#3FB950" BorderThickness="1">
                                                                                <TextBlock Text="{Binding}" Foreground="#3FB950" FontSize="12" FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </materialDesign:Card>

                                                    <materialDesign:Card Grid.Column="1" Margin="4" Padding="10"
                                                                        UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialIcons:MaterialIcon Kind="Barcode" Width="18" Height="18" Foreground="#56D364"/>
                                                                <TextBlock Margin="6,0,0,0" Foreground="#56D364" FontSize="13" FontWeight="SemiBold" Text="All Barcodes"/>
                                                            </StackPanel>
                                                            <ScrollViewer Margin="0,6,0,0" MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding BarcodeListItems}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="3" Padding="8,4" CornerRadius="10"
                                                                                    Background="#1A56D364" BorderBrush="#56D364" BorderThickness="1">
                                                                                <TextBlock Text="{Binding}" Foreground="#56D364" FontSize="12" FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </materialDesign:Card>
                                                </Grid>

                                                <!-- OCR Result -->
                                                <materialDesign:Card Margin="8,8,8,10" Padding="10"
                                                                    UniformCornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Background="#0D1117">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialIcons:MaterialIcon Kind="FileText" Width="18" Height="18" Foreground="#8B949E"/>
                                                            <TextBlock Margin="6,0,0,0" Foreground="#8B949E" FontSize="13" FontWeight="SemiBold" Text="OCR Text"/>
                                                        </StackPanel>
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160" Margin="0,6,0,0">
                                                            <TextBox Text="{Binding OCRResult}"
                                                                     TextWrapping="Wrap"
                                                                     IsReadOnly="True"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     Foreground="#C9D1D9"
                                                                     FontSize="13"
                                                                     FontFamily="Consolas"
                                                                     VerticalScrollBarVisibility="Disabled"/>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </materialDesign:Card>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Images">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0D1117">
                            <ItemsControl ItemsSource="{Binding ResultDataList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" BorderThickness="1" Background="#161B22" BorderBrush="#30363D" Margin="10" Padding="12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <materialIcons:MaterialIcon Kind="Image" Width="20" Height="20" Foreground="#58A6FF"/>
                                                    <TextBlock Margin="8,0,0,0" Foreground="#58A6FF" FontSize="15" FontWeight="SemiBold" Text="Captured Images"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding GridItems}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="4"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="160" Height="100" Margin="4" Padding="6"
                                                                    CornerRadius="6" BorderThickness="1" BorderBrush="#30363D" Background="#0D1117">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ImageIndex}"
                                                                               FontSize="14" FontWeight="Bold"
                                                                               Foreground="#58A6FF"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding Barcodes}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="11"
                                                                               Foreground="#56D364"
                                                                               Margin="0,0,0,2"/>
                                                                    <TextBlock Text="{Binding Dates}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="11"
                                                                               Foreground="#3FB950"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Grid>

            <!-- Footer Buttons -->
            <Grid Grid.Row="1">
                <StackPanel Margin="5,5,7,8" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Background="#238636" Foreground="#FFFFFF" Content="Restart Process" FontSize="13" FontWeight="SemiBold"
                            Padding="16,6" HorizontalAlignment="Right" Margin="10,0,10,0" BorderThickness="0"
                            Cursor="Hand" Click="RestartButton_Click"/>
                    <Button Click="CloseButton_Click" Width="90" Content="Close" Foreground="#C9D1D9"
                            VerticalAlignment="Center" HorizontalContentAlignment="Center"
                            Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Padding="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
