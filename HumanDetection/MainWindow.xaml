<Window x:Class="HumanDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumanDetection" xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" WindowState="Normal" 
          WindowStyle="None"
           SizeToContent="Manual" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="/Images/innovent.ico" 
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut"/>

        <Storyboard x:Key="CameraFlashStoryboard">
            <DoubleAnimation
            Storyboard.TargetProperty="Opacity"
            From="0"
            To="1"
            Duration="0:0:0.2"
            AutoReverse="True"
            RepeatBehavior="1x" />
        </Storyboard>
        

        <!-- Pallet slide-in from left -->
        <Storyboard x:Key="ShowPalletFromTopStoryboard">
            <!-- Move vertically -->
            <DoubleAnimation
            Storyboard.TargetName="PaletImageTransform"
            Storyboard.TargetProperty="Y"
            From="-400"
            To="0"
            Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <StaticResource ResourceKey="EaseInOutCubic"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Fade in -->
            <DoubleAnimation
            Storyboard.TargetName="PaletImage"
            Storyboard.TargetProperty="Opacity"
            From="0"
            To="1"
            Duration="0:0:1"/>
        </Storyboard>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="ImageDialogHost"
                               x:Name="ImageDialogHost">
        <materialDesign:DialogHost.DialogContent>
            <Grid>
                <Border x:Name="PictureDialog"
                        Background="#222"
                        CornerRadius="12"
                        Width="800"
                        Height="600"
                        Padding="10"
                        SnapsToDevicePixels="True">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <!-- Image -->
                        <Image x:Name="DialogImage" Grid.Row="0"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0"/>

                        <Button Grid.Row="1" Content="Close" Width="100" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="CloseDialog_Click"/>
                    </Grid>
                </Border>
                <local:ResultDialog x:Name="ResultDialoag" Width="800"></local:ResultDialog>
            </Grid>
        </materialDesign:DialogHost.DialogContent>

        <Grid  Margin="0" Background="Black" MouseDown="TitleBar_MouseDown">

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Black">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side - Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                    <!-- Your logo/image -->
                    <Image Source="/Images/innovent.ico" Width="20" Height="20" Margin="0,0,5,0"/>
                    <!-- Application title -->
                    <TextBlock Text="Vistion AI" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Side - Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Minimize Button -->
                    <Button Width="50" Height="25" Click="MinimizeButton_Click" ToolTip="Minimize" 
            Background="Transparent" BorderBrush="Transparent">
                        <materialIcons:MaterialIcon Kind="WindowMinimize" Width="20" Height="20" Foreground="White"/>
                    </Button>
                    <!-- Maximize/Restore Button -->
                    <Button Width="50" Height="25" Click="MaximizeRestoreButton_Click" ToolTip="Maximize/Restore" 
            Background="Transparent" BorderBrush="Transparent">
                        <materialIcons:MaterialIcon Kind="WindowMaximize" Width="20" Height="20" Foreground="White"/>
                    </Button>
                    <!-- Close Button -->
                    <Button Width="50" Height="25" Click="CloseButton_Click" ToolTip="Close" 
            Background="Transparent" BorderBrush="Transparent">
                        <materialIcons:MaterialIcon Kind="WindowClose" Width="20" Height="20" Foreground="Red"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Background="Transparent" CornerRadius="10" Margin="10,5,10,5" BorderBrush="Indigo" BorderThickness="3"  Grid.Row="1">
                <Grid Background="Transparent" >
                    <!-- Define Grid Columns -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*" MinWidth="400"/>
                        <!-- Main content (80%) -->
                        <ColumnDefinition Width="5"/>
                        <!-- Splitter width -->
                        <ColumnDefinition Width="2*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent"  CornerRadius="5" BorderBrush="Indigo" BorderThickness="0"
    
    Padding="0" Margin="5,5,5,5" >
                        <Grid Background="#333" Margin="5,5,5,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <!-- Video Background Layer -->
                                <Border Padding="5,5,5,5" 
                            Background="Transparent" CornerRadius="6"
                            BorderBrush="SlateBlue" BorderThickness="2"
                            SnapsToDevicePixels="True">
                                    <!--<Grid>
                                -->
                                    <!-- Live Video Feed -->
                                    <!--
                                <Image Name="BoxCountingCameraFeed" Stretch="Fill" />
                                -->
                                    <!-- Status Overlay -->
                                    <!--
                                <TextBlock Name="BoxCountingStatusText"
                               Text="Initializing..."
                               Foreground="White"
                               Background="#66000000"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Padding="10"
                               TextAlignment="Center"
                               Visibility="Visible"/>
                            </Grid>-->
                                </Border>
                                <Grid VerticalAlignment="Top" Margin="10,2,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Clock -->
                                    <StackPanel Grid.Column="0" Margin="10,5,10,10" Orientation="Vertical" HorizontalAlignment="Left">
                                        <Image Source="pack://application:,,,/Resources/Images/clock.png" Height="64" Width="64"/>
                                        <TextBlock x:Name="CountdownText" FontSize="20" Foreground="White" Text="06 Sec" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Center Camera Icon -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border BorderBrush="Gray"  BorderThickness="2"  Background="#111"
                                            CornerRadius="8" Width="118" Height="126" Padding="2,10,2,2">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <Image Source="pack://application:,,,/Resources/Images/camera.png" Height="64" Width="64"/>
                                                <TextBlock FontSize="20" Foreground="White" Text="Cam Top" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right Side: Human Image & Info -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Human Image -->
                                            <Grid Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,50,0">
                                                <Image x:Name="HumanImage"
                                               Source="pack://application:,,,/Resources/Images/human.png"
                                               Height="130" Width="130">
                                                    <Image.RenderTransform>
                                                        <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5"/>
                                                    </Image.RenderTransform>
                                                </Image>
                                            </Grid>

                                            <!-- Sensor & Status Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Sensor Lidar -->
                                                    <!-- Sensor -->
                                                    <Grid Grid.Row="0" Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                            <Image Source="pack://application:,,,/Resources/Images/sensor.png" Height="18" Width="18"/>
                                                            <TextBlock Margin="10,0,0,0" Text="Sensor Lidar" Foreground="White" FontSize="14"/>
                                                        </StackPanel>
                                                        <Image x:Name="SensorIndicator" 
                                                           Source="pack://application:,,,/Resources/Images/off_indicator.png"
                                                           Height="18" Width="18"
                                                           Grid.Column="1"
                                                           HorizontalAlignment="Right"/>
                                                    </Grid>

                                                    <!-- Temperature -->
                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                            <Image Source="pack://application:,,,/Resources/Images/temperature.png" Height="18" Width="18"/>
                                                            <TextBlock Margin="10,0,0,0" Text="Temperature 33°C" Foreground="White" FontSize="14"/>
                                                        </StackPanel>
                                                        <Image x:Name="TemperatureIndicator" 
                                                           Source="pack://application:,,,/Resources/Images/off_indicator.png"
                                                           Height="16" Width="16"
                                                           Grid.Column="1"
                                                           HorizontalAlignment="Right"/>
                                                    </Grid>


                                                    <!-- Humidity -->
                                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                            <Image Source="pack://application:,,,/Resources/Images/humidity.png" Height="18" Width="18"/>
                                                            <TextBlock Margin="10,0,0,0" Text="Humidity 67%" Foreground="White" FontSize="14"/>
                                                        </StackPanel>
                                                        <Image x:Name="HumidityIndicator"
           Source="pack://application:,,,/Resources/Images/off_indicator.png"
           Height="16" Width="16"
           Grid.Column="1"
           HorizontalAlignment="Right"/>
                                                    </Grid>

                                                    <!-- Motor Condition -->
                                                    <Grid Grid.Row="3" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                            <Image Source="pack://application:,,,/Resources/Images/motor.png" Height="18" Width="18"/>
                                                            <TextBlock Margin="10,0,0,0" Text="Motor Condition" Foreground="White" FontSize="14"/>
                                                        </StackPanel>
                                                        <Image x:Name="MotorIndicator"
                                                       Source="pack://application:,,,/Resources/Images/off_indicator.png"
                                                       Height="16" Width="16"
                                                       Grid.Column="1"
                                                       HorizontalAlignment="Right"/>
                                                    </Grid>

                                                </Grid>
                                            </StackPanel>

                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <!-- Top Info Panel Overlay -->
                                <Grid VerticalAlignment="Top" Margin="10,150,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Entry -->
                                    <Border Grid.Column="0" Margin="5" CornerRadius="10" BorderBrush="White" BorderThickness="1" Background="#333">
                                        <StackPanel Height="65" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Margin="10,0">
                                            <TextBlock Text="Entry" FontSize="14" Foreground="White" HorizontalAlignment="Left"/>
                                            <TextBlock Text="12:20:35" FontSize="24" Foreground="White" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Exit -->
                                    <Border Grid.Column="1" Margin="5" CornerRadius="10" BorderBrush="White" BorderThickness="1" Background="#333">
                                        <StackPanel Height="65" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Margin="10,0">
                                            <TextBlock Text="Exit" FontSize="14" Foreground="White" HorizontalAlignment="Left"/>
                                            <TextBlock Text="12:20:35" FontSize="24" Foreground="White" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Height -->
                                    <Border Grid.Column="2" Margin="5" CornerRadius="10" BorderBrush="White" BorderThickness="1" Background="#333">
                                        <StackPanel Height="65" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Margin="10,0">
                                            <TextBlock Text="Height" FontSize="14" Foreground="White" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="PalletHeightTxt" Text="0" FontSize="24" Foreground="White" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Box Count -->
                                    <Border Grid.Column="3" Margin="5" CornerRadius="10" BorderBrush="White" BorderThickness="1" Background="#333">
                                        <StackPanel Height="65" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Margin="10,0">
                                            <TextBlock Text="Box Count" FontSize="14" Foreground="White" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="NoBoxTxt" Text="0" FontSize="16" Foreground="White" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Condition -->
                                    <Border Grid.Column="4" Margin="5" CornerRadius="10" BorderBrush="White" BorderThickness="1" Background="#333">
                                        <StackPanel Height="65" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Margin="10,0">
                                            <TextBlock Text="Condition" FontSize="14" Foreground="White" HorizontalAlignment="Left"/>
                                            <TextBlock Text="OK" FontSize="24" Foreground="White" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Weight -->
                                    <Border Grid.Column="5" Margin="5" CornerRadius="10" BorderBrush="White" BorderThickness="1" Background="#333">
                                        <StackPanel Height="65" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Margin="10,0">
                                            <TextBlock Text="Weight" FontSize="14" Foreground="White" HorizontalAlignment="Left"/>
                                            <TextBlock Text="50 KG" FontSize="24" Foreground="White" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image
                                x:Name="PaletImage"
                                Source="pack://application:,,,/Resources/Images/palet.png"
                                Height="450"
                                Width="474"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TranslateTransform x:Name="PaletImageTransform" X="0" Y="0"/>
                                        </Image.RenderTransform>
                                    </Image>

                                </Grid>
                                <!-- Bottom Camera Controls -->
                                <Grid VerticalAlignment="Bottom" Margin="20,0,20,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cam Left -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <Border  x:Name="CamRightLightPulse" BorderBrush="Gray" BorderThickness="2"  Background="#111"
                                            CornerRadius="8" Width="118" Height="126" Padding="2,10,2,2">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <Grid Width="64" Height="64">
                                                    <Ellipse x:Name="RightFlashEllipse"
                                                  Fill="#00FF00"
                                                  Opacity="0.0"
                                                  Width="64"
                                                  Height="64">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#00FF00" BlurRadius="20" ShadowDepth="0"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Image x:Name="CameraImage" Source="pack://application:,,,/Resources/Images/camera.png" Height="64" Width="64"/>
                                                </Grid>
                                                <TextBlock FontSize="18" Foreground="White" Text="Cam Left" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Cam Front -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <Border x:Name="CamFrontLightPulse"
                                BorderBrush="#00E108"
                                BorderThickness="2"
                                CornerRadius="8" 
                                Width="118"
                                Height="126"
                                Padding="2,10,2,2"
                                Background="#111">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <Grid Width="64" Height="64">
                                                    <!-- Ellipse for flashing effect -->
                                                    <Ellipse x:Name="FrontFlashEllipse"
                                                 Fill="#00FF00"
                                                 Opacity="0.0"
                                                 Width="64"
                                                 Height="64">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#00FF00" BlurRadius="20" ShadowDepth="0"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>

                                                    <Image x:Name="CamFrontCameraImage"
                   Source="pack://application:,,,/Resources/Images/camera.png"
                   Height="64"
                   Width="64"/>
                                                </Grid>

                                                <TextBlock FontSize="18"
                   Foreground="White"
                   Text="Cam Front"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>


                                    <!-- Cam Right -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Border x:Name="CamLeftLightPulse" BorderBrush="Gray"   Background="#111"  BorderThickness="2"
                                    CornerRadius="8" Width="118" Height="126" Padding="2,10,2,2">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <Grid Width="64" Height="64">
                                                    <Ellipse x:Name="LeftFlashEllipse"
                                                     Fill="#00FF00"
                                                     Opacity="0.0"
                                                     Width="64"
                                                     Height="64">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#00FF00" BlurRadius="20" ShadowDepth="0"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Image Source="pack://application:,,,/Resources/Images/camera.png" Height="64" Width="64"/>
                                                </Grid>
                                                <TextBlock FontSize="18" Foreground="White" Text="Cam Right" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Sidebar (20%) - Initially hidden -->

                    <GridSplitter Grid.Column="1"
                  Width="5"
                  Background="Gray"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"/>

                    <!-- Sidebar Content with Rounded Corners -->
                    <Grid Grid.Column="2" Background="Transparent" VerticalAlignment="Stretch">



                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <!-- Top panel for live view -->
                                <RowDefinition Height="*"/>
                                <!-- Bottom panel for results -->
                            </Grid.RowDefinitions>

                            <!-- Top Panel - Live Video Feed -->


                            <!-- Bottom Panel - OCR Results -->
                            <Border Grid.Row="0"
                            Margin="1,1,1,1"
                            Background="#333"
                            CornerRadius="6"
                            BorderBrush="SlateBlue"
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            ClipToBounds="True"
                            Effect="{DynamicResource DropShadow}">

                                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Margin="20"
                  Background="Transparent">
                                        <ItemsControl ItemsSource="{Binding CapturedImages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="10"
                                                        CornerRadius="5"
                                                        BorderBrush="#00E108"
                                                        BorderThickness="1"
                                                        Width="239"
                                                        Height="160"
                                                        Background="#111"
                                                        SnapsToDevicePixels="True"
                                                        Effect="{DynamicResource MaterialDesignShadowElevation3}"
                                                        MouseLeftButtonUp="Image_Click">

                                                        <!-- Clip Image to Rounded Border -->
                                                        <!--<Border.Clip>
                                                            <RectangleGeometry RadiusX="20" RadiusY="20"
                                                            Rect="0,0,240,180"/>
                                                        </Border.Clip>-->

                                                        <!-- Image inside -->
                                                        <Image Source="{Binding}" Margin="2,2,2,2"
                                                           Stretch="UniformToFill"
                                                           Opacity="0.97"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           RenderOptions.EdgeMode="Aliased"/>
                                                    </Border>
                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>


                        </Grid>
                    </Grid>



                </Grid>
            </Border>
            <!-- Loading Overlay -->
            <Grid x:Name="LoadingOverlay" 
  Grid.RowSpan="2" 
  Panel.ZIndex="999" 
  Background="#CC000000" 
  Visibility="Visible">
                <Border Background="#333" 
        CornerRadius="10" 
        Padding="20" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" 
                     Width="200" 
                     Height="20" 
                     Margin="0,0,0,10"/>
                        <TextBlock x:Name="ProgressTxt" Text="Please wait loading AI Models..." 
                   Foreground="White" 
                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
