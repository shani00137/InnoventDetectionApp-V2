<Window x:Class="HumanDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumanDetection" xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" WindowState="Normal" 
          WindowStyle="None"
           SizeToContent="Manual" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="/Images/innovent.ico" 
        Title="MainWindow" Height="450" Width="800">

    <materialDesign:DialogHost x:Name="NavConfirmDialogHost">
        <materialDesign:DialogHost.DialogContent>
            <Border CornerRadius="8" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Width="420" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="26" Height="26" Foreground="#FBBF24"/>
                        <TextBlock Text="Switch Screen" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="A process is currently running on the Home screen. If you switch now, all running processes will be stopped."
                               TextWrapping="Wrap" Foreground="#C9D1D9" FontSize="14" Margin="0,0,0,16"/>
                    <TextBlock Text="Are you sure you want to switch screen?"
                               TextWrapping="Wrap" Foreground="#8B949E" FontSize="13" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="No, stay" Width="100" Height="34" Margin="0,0,10,0"
                                Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1"
                                Click="NavConfirmNo_Click"/>
                        <Button Content="Yes, stop &amp; switch" Width="150" Height="34"
                                Background="#238636" Foreground="#FFFFFF" BorderThickness="0"
                                Click="NavConfirmYes_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <Grid  Margin="0" Background="Black" MouseDown="TitleBar_MouseDown">

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
          
            <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Black">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side - Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                    <!-- Your logo/image -->
                    <Image Source="/Images/innovent.ico" Width="20" Height="20" Margin="0,0,5,0"/>
                    <!-- Application title -->
                    <TextBlock Text="Vistion AI" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <Button x:Name="HomeNavBtn" Click="NavToHomePage_Click" Background="Transparent" Width="100" Height="32" Foreground="White" Margin="0" Padding="10,0"
         BorderBrush="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="HomeAlertOutline" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="Home"  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SettingNavBtn" Click="NavToSettingPage_Click" Background="Transparent" Width="100" Height="32" Foreground="White"  Padding="10,0"
         BorderBrush="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="SettingsOutline" Width="20" Height="20" Margin="0,0,0,0"/>
                        <TextBlock Text="Settings"  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ReportsNavBtn" Click="NavToReportsPage_Click" Background="Transparent" Width="110" Height="32" Foreground="White"  Padding="10,0"
         BorderBrush="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="Reports"  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="TestingNavBtn" Click="NavToTestingPage_Click" Background="Transparent" Width="110" Height="32" Foreground="White"  Padding="10,0"
         BorderBrush="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="FlaskOutline" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="Testing"  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="MoxaStatusNavBtn" Click="NavToMoxaStatusPage_Click" Background="Transparent" Width="120" Height="32" Foreground="White"  Padding="10,0"
         BorderBrush="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="LanConnect" Width="20" Height="20" Margin="0,0,5,0"/>
                        <TextBlock Text="Moxa Status"  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

                <!-- Right Side - Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Minimize Button -->
                    <Button Width="50" Height="25" Click="MinimizeButton_Click" ToolTip="Minimize" 
            Background="Transparent" BorderBrush="Transparent">
                        <materialIcons:MaterialIcon Kind="WindowMinimize" Width="20" Height="20" Foreground="White"/>
                    </Button>
                    <!-- Maximize/Restore Button -->
                    <Button Width="50" Height="25" Click="MaximizeRestoreButton_Click" ToolTip="Maximize/Restore" 
            Background="Transparent" BorderBrush="Transparent">
                        <materialIcons:MaterialIcon Kind="WindowMaximize" Width="20" Height="20" Foreground="White"/>
                    </Button>
                    <!-- Close Button -->
                    <Button Width="50" Height="25" Click="CloseButton_Click" ToolTip="Close" 
            Background="Transparent" BorderBrush="Transparent">
                        <materialIcons:MaterialIcon Kind="WindowClose" Width="20" Height="20" Foreground="Red"/>
                    </Button>
                </StackPanel>
            </Grid>
    
        <Grid Grid.Row="1" Background="Black" Margin="10">

            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
        </Grid>
        </Grid>
    </materialDesign:DialogHost>

</Window>
