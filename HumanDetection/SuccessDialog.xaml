<UserControl x:Class="HumanDetection.SuccessDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500">
    <Border CornerRadius="12" Background="#1A1A1A" BorderBrush="SlateBlue" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button x:Name="CloseButton"
                    Width="50" Height="50"
                    Background="Transparent" 
                   
                    BorderBrush="Transparent"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-10,0,0"
                    Click="CloseButton_Click">
                <materialIcons:MaterialIcon Kind="Close" Width="25" Height="25" Foreground="White"/>
            </Button>

            <!-- Success Icon -->
            <Border Grid.Row="0"
                    Width="80" Height="80"
                    CornerRadius="40"
                    Background="#0D2A1E"
                    BorderBrush="#34C759"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">
                <Image Source="/Resources/Images/check.png" Width="40" Height="40"/>
            </Border>

            <!-- Success Message -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Process Complete"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#34C759"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Waiting for New Pallet"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Timing Breakdown -->
            <Border Grid.Row="2"
                    CornerRadius="8"
                    Background="#222"
                    BorderBrush="#333"
                    BorderThickness="1"
                    Padding="18,12"
                    Margin="0,8,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialIcons:MaterialIcon Kind="TimerOutline" Width="18" Height="18" Foreground="#888"/>
                        <TextBlock Text="Process Timing" FontSize="14" FontWeight="Bold" Foreground="#C9D1D9" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Picture Capture" Foreground="#8B949E" FontSize="13"/>
                        <TextBlock x:Name="TimingCapture" Grid.Row="0" Grid.Column="1" Text="--" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Box Counting Model" Foreground="#8B949E" FontSize="13"/>
                        <TextBlock x:Name="TimingBoxCounting" Grid.Row="1" Grid.Column="1" Text="--" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="OCR Service" Foreground="#8B949E" FontSize="13"/>
                        <TextBlock x:Name="TimingOcr" Grid.Row="2" Grid.Column="1" Text="--" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Process" Foreground="#FBBF24" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TimingTotal" Grid.Row="3" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="3"
                    CornerRadius="6"
                    Background="#222"
                    BorderBrush="#333"
                    BorderThickness="1"
                    Padding="15,8"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#34C759" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="System Ready"
                               FontSize="12"
                               Foreground="#888"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
