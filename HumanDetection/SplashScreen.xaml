<Window x:Class="HumanDetection.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumanDetection" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="SplashScreen" Height="450" Width="800">
    <Border CornerRadius="10" Background="{DynamicResource MaterialDesignPaper}" 
            BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
            Effect="{StaticResource MaterialDesignShadowDepth4}">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- App Logo/Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountGroup" Width="64" Height="64" 
                                        Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                <TextBlock Text="Human Detection" Margin="0,10,0,0"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
            </StackPanel>

            <!-- Loading Indicator -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!--<materialDesign:LoadingProgressBar IsIndeterminate="True" Height="6" Margin="0,20,0,0"
                                                  Foreground="{DynamicResource SecondaryHueMidBrush}"/>-->
                <TextBlock x:Name="StatusText" Text="Initializing application..." Margin="0,15,0,0"
                           HorizontalAlignment="Center" 
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
            </StackPanel>

            <!-- Version Info -->
            <TextBlock Grid.Row="2" Text="v1.0.0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                      Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
        </Grid>
    </Border>
</Window>
