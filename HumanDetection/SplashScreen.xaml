<Window x:Class="HumanDetection.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HumanDetection"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Vision AI" Height="540" Width="760"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        ShowInTaskbar="True"
        Loaded="SplashScreen_Loaded">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a1a2e" Offset="0"/>
                <GradientStop Color="#252540" Offset="0.55"/>
                <GradientStop Color="#26264a" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative top accent line -->
        <Border VerticalAlignment="Top" Height="4" Background="#787AFF" Opacity="0.9"/>

        <Grid Margin="46,30,46,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Branding -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Border Width="58" Height="58" CornerRadius="14"
                        Background="#787AFF" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="RobotIndustrial" Width="34" Height="34"
                                                Foreground="#1a1a2e" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Vision AI" FontSize="28" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Intelligent Pallet Detection System" FontSize="13"
                               Foreground="#8B93A7" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Diagnostic checklist -->
            <Border Grid.Row="1" Margin="0,34,0,0" Background="#252540" CornerRadius="16"
                    BorderBrush="#3a3a5c" BorderThickness="1" Padding="26,22">
                <StackPanel>
                    <!-- AI MODELS -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon x:Name="AiIcon" Kind="RobotOutline" Width="30" Height="30"
                                                        Foreground="#787AFF"/>
                            <ProgressBar x:Name="AiLoading" Width="22" Height="22"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True" Foreground="#787AFF"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="AiError" Text="!" FontSize="15" FontWeight="Bold" Foreground="#FF5252"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AI Models" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AiSub" Text="Loading box counting &amp; human detection..." Foreground="#7C87A0" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#3a3a5c" Margin="0,12"/>

                    <!-- WEIGHT MACHINE -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon x:Name="WeightIcon" Kind="ScaleBathroom" Width="30" Height="30"
                                                        Foreground="#787AFF"/>
                            <ProgressBar x:Name="WeightLoading" Width="22" Height="22"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True" Foreground="#787AFF"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="WeightError" Text="!" FontSize="15" FontWeight="Bold" Foreground="#FF5252"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Weight Machine" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WeightSub" Text="Connecting to weight scale..." Foreground="#7C87A0" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#3a3a5c" Margin="0,12"/>

                    <!-- MOXA CONTROLLER -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon x:Name="MoxaIcon" Kind="LanConnect" Width="30" Height="30"
                                                        Foreground="#787AFF"/>
                            <ProgressBar x:Name="GpioLoading" Width="22" Height="22"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True" Foreground="#787AFF"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="GpioError" Text="!" FontSize="15" FontWeight="Bold" Foreground="#FF5252"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Moxa Controller (IO)" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpioSub" Text="Verifying Moxa network device..." Foreground="#7C87A0" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#3a3a5c" Margin="0,12"/>

                    <!-- OCR SERVICE -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Grid Width="30" Height="30">
                            <materialIcons:MaterialIcon x:Name="OcrIcon" Kind="TextRecognition" Width="30" Height="30"
                                                        Foreground="#787AFF"/>
                            <ProgressBar x:Name="APILoading" Width="22" Height="22"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True" Foreground="#787AFF"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="APIError" Text="!" FontSize="15" FontWeight="Bold" Foreground="#FF5252"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OCR Service" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="APISub" Text="Starting PaddleOCR engine..." Foreground="#7C87A0" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status text -->
            <Grid Grid.Row="3" Margin="0,22,0,0">
                <ProgressBar x:Name="MainProgress" IsIndeterminate="True" Height="4"
                             Foreground="#787AFF" Background="#3a3a5c"/>
                <TextBlock x:Name="StatusTxt" Text="Please wait while the application initializes..."
                           Foreground="#8B93A7" FontSize="12.5" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <TextBlock Text="© 2026 Innovent · Version 2.0" Foreground="#5A6380" FontSize="11"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="ReadyTxt" Text="Loading..." Foreground="#787AFF" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>