<Page x:Class="HumanDetection.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Dashboard"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3a3a5c"/>
        </Style>
    </Page.Resources>

    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,16,20,4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Border Width="44" Height="44" CornerRadius="10" Background="#787AFF" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="26" Height="26"
                                            Foreground="#1a1a2e" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Dashboard" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="GreetingTxt" Text="System overview" Foreground="#8B93A7" FontSize="12.5" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ClockTxt" Text="" Foreground="#787AFF" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="40,0,0,0"/>
        </StackPanel>

        <!-- Readiness banner -->
        <Border Grid.Row="1" Margin="20,8,20,0" Background="#252540" CornerRadius="12"
                BorderBrush="#3a3a5c" BorderThickness="1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialIcons:MaterialIcon x:Name="ReadyIcon" Kind="CheckCircleOutline" Width="30" Height="30"
                                            Foreground="#787AFF" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ReadyTitle" Text="System Ready" Foreground="#787AFF" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="All detection components are online. You can start a pallet detection now."
                               Foreground="#8B93A7" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="StartDetectionBtn" Content="▶  Start Detection"
                        Width="170" Height="44" Background="#787AFF" Foreground="#1a1a2e"
                        BorderThickness="0" FontWeight="Bold" FontSize="14"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Cursor="Hand" Click="StartDetection_Click"/>
            </Grid>
        </Border>

        <!-- Dashboard cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16,10,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- System status cards -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- AI Models -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <materialIcons:MaterialIcon Kind="RobotOutline" Width="30" Height="30" Foreground="#787AFF"/>
                            <TextBlock Text="AI MODELS" Foreground="#8B93A7" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ModelsStatus" Text="Loading..." Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                            <TextBlock x:Name="ModelsDetail" Text="Box counting · Human detection" Foreground="#5A6380" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Weight machine -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <materialIcons:MaterialIcon Kind="ScaleBathroom" Width="30" Height="30" Foreground="#787AFF"/>
                            <TextBlock Text="WEIGHT MACHINE" Foreground="#8B93A7" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="WeightStatus" Text="Checking..." Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                            <TextBlock x:Name="WeightDetail" Text="Scale serial link" Foreground="#5A6380" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Moxa -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <materialIcons:MaterialIcon Kind="LanConnect" Width="30" Height="30" Foreground="#787AFF"/>
                            <TextBlock Text="MOXA CONTROLLER" Foreground="#8B93A7" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="MoxaStatus" Text="Checking..." Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                            <TextBlock x:Name="MoxaDetail" Text="GPIO / sensors" Foreground="#5A6380" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- OCR -->
                    <Border Grid.Column="3" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <materialIcons:MaterialIcon Kind="TextRecognition" Width="30" Height="30" Foreground="#787AFF"/>
                            <TextBlock Text="OCR SERVICE" Foreground="#8B93A7" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="OcrStatus" Text="Checking..." Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                            <TextBlock x:Name="OcrDetail" Text="PaddleOCR · port 5000" Foreground="#5A6380" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick access -->
                <TextBlock Grid.Row="1" Text="QUICK ACCESS" Foreground="#8B93A7" FontSize="12" FontWeight="SemiBold" Margin="4,24,4,6"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="GoHomeBtn" Grid.Column="0" Margin="4" Height="90" Background="#252540"
                            BorderBrush="#3a3a5c" BorderThickness="1" Cursor="Hand" Click="GoHome_Click"
                            materialDesign:ButtonAssist.CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="HomeAlertOutline" Width="28" Height="28" Foreground="#787AFF"
                                                        HorizontalAlignment="Center"/>
                            <TextBlock Text="Detection" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="GoReportsBtn" Grid.Column="1" Margin="4" Height="90" Background="#252540"
                            BorderBrush="#3a3a5c" BorderThickness="1" Cursor="Hand" Click="GoReports_Click"
                            materialDesign:ButtonAssist.CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="28" Height="28" Foreground="#787AFF"
                                                        HorizontalAlignment="Center"/>
                            <TextBlock Text="Reports" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="GoSettingsBtn" Grid.Column="2" Margin="4" Height="90" Background="#252540"
                            BorderBrush="#3a3a5c" BorderThickness="1" Cursor="Hand" Click="GoSettings_Click"
                            materialDesign:ButtonAssist.CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="SettingsOutline" Width="28" Height="28" Foreground="#787AFF"
                                                        HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="GoMoxaBtn" Grid.Column="3" Margin="4" Height="90" Background="#252540"
                            BorderBrush="#3a3a5c" BorderThickness="1" Cursor="Hand" Click="GoMoxa_Click"
                            materialDesign:ButtonAssist.CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="LanConnect" Width="28" Height="28" Foreground="#787AFF"
                                                        HorizontalAlignment="Center"/>
                            <TextBlock Text="Moxa Status" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>