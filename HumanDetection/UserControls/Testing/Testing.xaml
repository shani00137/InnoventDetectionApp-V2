<Page x:Class="UserControls.Testing.Testing"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
      xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Testing">

    <Page.Resources>
        <Style x:Key="TestBorder" TargetType="Border">
            <Setter Property="Background" Value="#09090B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#222228"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="#09090B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1C3A54"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,10">
            <materialIcons:MaterialIcon Kind="FlaskOutline" Width="22" Height="22" Margin="0,2,8,0" Foreground="White"/>
            <TextBlock Text="DETECTION TESTING" FontSize="20" Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Image Upload + Start -->
        <Border Grid.Row="1" Style="{StaticResource TestBorder}" Margin="10,0,10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectImagesBtn" Width="160" Height="42" Click="SelectImagesBtn_Click"
                            Style="{StaticResource RoundButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="FolderImage" Width="18" Height="18" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="Select Images" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SelectedCountTxt" Text="Select 4 to 5 images" Foreground="#9CA3AF" FontSize="13"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button x:Name="StartProcessBtn" Width="140" Height="42" Margin="15,0,0,0"
                            Click="StartProcessBtn_Click" IsEnabled="False"
                            Style="{StaticResource RoundButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="PlayCircle" Width="18" Height="18" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="Start Process" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="ProgressTxt" Text="" Foreground="#60A5FA" FontSize="13"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <TextBlock Text="Time: " Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <TextBlock x:Name="TimeTxt" Text="-" Foreground="#4ADE80" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button x:Name="ClearBtn" Width="110" Height="36" Click="ClearBtn_Click"
                            Style="{StaticResource RoundButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="Selected Images" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="2,12,0,6"/>
                <ItemsControl x:Name="ImagesList" Height="150">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Background="#111113" CornerRadius="8" BorderBrush="#222228" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding}" Stretch="Uniform" Margin="4"/>
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#66000000"
                                            CornerRadius="4" Padding="4,1" Margin="4">
                                        <TextBlock Text="{Binding Index}" Foreground="White" FontSize="10"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="2" Margin="10,0,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Metric cards -->
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="SCORE" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="ScoreTxt" Text="-" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="BOXES" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="BoxesTxt" Text="-" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="HEIGHT (m)" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="HeightTxt" Text="-" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="HUMAN" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="HumanTxt" Text="-" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="BARCODES" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="BarcodesTxt" Text="-" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="DATES" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock x:Name="DatesTxt" Text="-" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Annotated + OCR -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TestBorder}" Margin="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ANNOTATED IMAGES" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AnnotatedList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3" Background="#111113" CornerRadius="6" BorderBrush="#222228" BorderThickness="1">
                                            <Image Source="{Binding}" Stretch="Uniform" Margin="4"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TestBorder}" Margin="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="OCR / BARCODE / DATE RESULT" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <TextBox x:Name="OCRResultBox" TextWrapping="Wrap" IsReadOnly="True" Background="#111113"
                                 Foreground="#D1D5DB" BorderBrush="#222228" BorderThickness="1"
                                 VerticalScrollBarVisibility="Auto" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#CC0A0A0A" Visibility="Collapsed"
              Panel.ZIndex="999">
            <Border Background="#111113" CornerRadius="14" BorderBrush="#222228" BorderThickness="1"
                    Padding="30,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="56" Height="56">
                        <Ellipse Width="56" Height="56" Stroke="#222228" StrokeThickness="5"/>
                        <Ellipse Width="56" Height="56" Stroke="#787AFF" StrokeThickness="5"
                                 StrokeDashArray="80 160" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="OverlayProgressTxt" Text="Processing..." Foreground="White" FontSize="14"
                               Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
