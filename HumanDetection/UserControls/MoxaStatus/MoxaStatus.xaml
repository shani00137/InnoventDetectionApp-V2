<Page x:Class="UserControls.MoxaStatus.MoxaStatus"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
      xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Moxa Status">

    <Page.Resources>
        <Style x:Key="MoxaStatusTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="MoxaStatusComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style x:Key="MoxaBorder" TargetType="Border">
            <Setter Property="Background" Value="#09090B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#222228"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
        <Style x:Key="LabelTxt" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,10">
            <materialIcons:MaterialIcon Kind="LanConnect" Width="22" Height="22" Margin="0,2,8,0" Foreground="White"/>
            <TextBlock Text="MOXA STATUS - DEVICE TEST" FontSize="20" Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
            <Border x:Name="ConnectionChip" Style="{StaticResource StatusChip}" Background="#1F2937" Margin="20,0,0,0">
                <TextBlock x:Name="ConnectionTxt" Text="Disconnected" Foreground="#9CA3AF" FontSize="12"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top: Connection + DO controls -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Connection -->
                    <Border Grid.Column="0" Style="{StaticResource MoxaBorder}" Margin="0,0,4,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="CONNECTION"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource LabelTxt}" Text="Moxa IP: "/>
                                <TextBox x:Name="MoxaIpTxt" Width="180" Text="192.168.1.135"
                                         Style="{StaticResource MoxaStatusTextBox}"
                                         materialDesign:HintAssist.Hint="Device IP"/>
                                <Button x:Name="ConnectBtn" Content="Connect" Width="90" Height="36" Margin="8,0,0,0"
                                        Style="{StaticResource RoundButton}" Click="ConnectBtn_Click"/>
                                <Button x:Name="TestBtn" Content="Test" Width="70" Height="36" Margin="8,0,0,0"
                                        Style="{StaticResource RoundButton}" Click="TestBtn_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource LabelTxt}" Text="DI Polling: "/>
                                <TextBox x:Name="DIPollChannelTxt" Width="50" Text="0"
                                         Style="{StaticResource MoxaStatusTextBox}"
                                         materialDesign:HintAssist.Hint="Ch"/>
                                <TextBlock Style="{StaticResource LabelTxt}" Text="(ms) "/>
                                <TextBox x:Name="DIPollIntervalTxt" Width="60" Text="200"
                                         Style="{StaticResource MoxaStatusTextBox}"/>
                                <Button x:Name="StartDICh" Content="Start DI" Width="80" Height="36" Margin="8,0,0,0"
                                        Style="{StaticResource RoundButton}" Click="StartDICh_Click"/>
                                <Button x:Name="StopDICh" Content="Stop DI" Width="80" Height="36" Margin="8,0,0,0"
                                        Style="{StaticResource RoundButton}" Click="StopDICh_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DO controls -->
                    <Border Grid.Column="1" Style="{StaticResource MoxaBorder}" Margin="4,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="DIGITAL OUTPUT (DO)"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock Text="DO0 - Buzzer" Style="{StaticResource LabelTxt}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button Content="ON" Width="45" Height="32" Margin="2" Style="{StaticResource RoundButton}" Tag="0:1" Click="DoBtn_Click"/>
                                        <Button Content="OFF" Width="45" Height="32" Margin="2" Style="{StaticResource RoundButton}" Tag="0:0" Click="DoBtn_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4">
                                    <TextBlock Text="DO1 - Rotator" Style="{StaticResource LabelTxt}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button Content="ON" Width="45" Height="32" Margin="2" Style="{StaticResource RoundButton}" Tag="1:1" Click="DoBtn_Click"/>
                                        <Button Content="OFF" Width="45" Height="32" Margin="2" Style="{StaticResource RoundButton}" Tag="1:0" Click="DoBtn_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4">
                                    <TextBlock Text="DO2 - Blower" Style="{StaticResource LabelTxt}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button Content="ON" Width="45" Height="32" Margin="2" Style="{StaticResource RoundButton}" Tag="2:1" Click="DoBtn_Click"/>
                                        <Button Content="OFF" Width="45" Height="32" Margin="2" Style="{StaticResource RoundButton}" Tag="2:0" Click="DoBtn_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4">
                                    <TextBlock Text="DO3 - Motor" Style="{StaticResource LabelTxt}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button Content="ON" Width="45" Height="32" Margin="2" Style="{StaticResource RoundButton}" Tag="3:1" Click="DoBtn_Click"/>
                                        <Button Content="OFF" Width="45" Height="32" Margin="2" Style="{StaticResource RoundButton}" Tag="3:0" Click="DoBtn_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Middle: custom DI read + DO write -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Custom DI read -->
                    <Border Grid.Column="0" Style="{StaticResource MoxaBorder}" Margin="0,0,4,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="READ DI (any channel)"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LabelTxt}" Text="Channel: "/>
                                <TextBox x:Name="DiReadChannelTxt" Width="50" Text="0"
                                         Style="{StaticResource MoxaStatusTextBox}"/>
                                <Button x:Name="ReadDiBtn" Content="Read DI" Width="90" Height="36" Margin="8,0,0,0"
                                        Style="{StaticResource RoundButton}" Click="ReadDiBtn_Click"/>
                                <TextBlock x:Name="DiReadResultTxt" Text="-" Foreground="#60A5FA" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="DI QUICK VIEW" Margin="0,16,0,6"/>
                            <ItemsControl x:Name="DiQuickList" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111113" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="#222228" Padding="10,6" Margin="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" Foreground="#9CA3AF" FontSize="12" Margin="0,0,8,0"/>
                                                <Border x:Name="Dot" Width="12" Height="12" CornerRadius="6"
                                                        Background="{Binding StateBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding State}" Foreground="White" FontSize="12" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Custom DO write -->
                    <Border Grid.Column="1" Style="{StaticResource MoxaBorder}" Margin="4,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="WRITE DO (any channel)"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LabelTxt}" Text="Channel: "/>
                                <TextBox x:Name="DoWriteChannelTxt" Width="50" Text="0"
                                         Style="{StaticResource MoxaStatusTextBox}"/>
                                <TextBlock Style="{StaticResource LabelTxt}" Text="Status: " Margin="10,0,0,0"/>
                                <ComboBox x:Name="DoWriteStatusCmb" Width="90" SelectedIndex="1"
                                          Style="{StaticResource MoxaStatusComboBox}">
                                    <ComboBoxItem Content="OFF"/>
                                    <ComboBoxItem Content="ON"/>
                                </ComboBox>
                                <Button Content="Send DO" Width="90" Height="36" Margin="8,0,0,0"
                                        Style="{StaticResource RoundButton}" Click="SendDoBtn_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="DoWriteResultTxt" Text="" Foreground="#4ADE80" FontSize="13" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Analog input (AI) test -->
                <Border Grid.Row="2" Style="{StaticResource MoxaBorder}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="READ AI - ANALOG INPUT"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LabelTxt}" Text="Channel: "/>
                            <TextBox x:Name="AiReadChannelTxt" Width="50" Text="0"
                                     Style="{StaticResource MoxaStatusTextBox}"/>
                            <TextBlock Style="{StaticResource LabelTxt}" Text="Signal: " Margin="10,0,0,0"/>
                            <ComboBox x:Name="AiSignalCmb" Width="110" SelectedIndex="0"
                                      Style="{StaticResource MoxaStatusComboBox}">
                                <ComboBoxItem Content="4-20 mA"/>
                                <ComboBoxItem Content="0-10 V"/>
                                <ComboBoxItem Content="0-5 V"/>
                                <ComboBoxItem Content="Raw (0-65535)"/>
                            </ComboBox>
                            <Button x:Name="ReadAiBtn" Content="Read AI" Width="90" Height="36" Margin="8,0,0,0"
                                    Style="{StaticResource RoundButton}" Click="ReadAiBtn_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource LabelTxt}" Text="Raw Code: "/>
                            <TextBlock x:Name="AiRawResultTxt" Text="-" Foreground="#60A5FA" FontSize="15"
                                       FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Style="{StaticResource LabelTxt}" Text="Scaled Value: "/>
                            <TextBlock x:Name="AiValueResultTxt" Text="-" Foreground="#4ADE80" FontSize="15"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bottom: activity log -->
                <Border Grid.Row="3" Style="{StaticResource MoxaBorder}" Margin="0,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="ACTIVITY LOG"/>
                        <TextBox x:Name="LogBox" TextWrapping="Wrap" IsReadOnly="True" Height="180"
                                 Background="#111113" Foreground="#D1D5DB" BorderBrush="#222228"
                                 VerticalScrollBarVisibility="Auto" FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>